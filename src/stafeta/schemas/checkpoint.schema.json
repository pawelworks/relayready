{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relayready:schema:checkpoint:0.1-draft",
  "title": "RelayReady experimental continuation checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["relayready_checkpoint", "task_id", "created", "expires_at", "handoff_sha256", "readback_sha256", "resources", "effects", "run_inputs"],
  "properties": {
    "relayready_checkpoint": {"const": "0.1-draft"},
    "task_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "created": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "handoff_sha256": {"$ref": "#/$defs/digest"},
    "readback_sha256": {"$ref": "#/$defs/digest"},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}, "uniqueItems": true},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}, "uniqueItems": true},
    "run_inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}, "uniqueItems": true}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "revision": {"$ref": "#/$defs/text"}}
    },
    "effect": {
      "type": "object", "additionalProperties": false, "required": ["id", "idempotency_key"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}}
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["name", "digest"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}}
    }
  }
}
